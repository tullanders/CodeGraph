{
  "name": "kuzu-codegraph-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "codegraph": "bin/codegraph.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "verify:kuzu": "tsx src/verify-kuzu.ts",
    "build": "tsc --noEmit",
    "explorer": "docker run --rm -p 8000:8000 -v \"$PWD/.codegraph/kuzu:/database/database.kz\" kuzudb/explorer:latest",
    "mcp": "tsx src/mcp-server.ts",
    "test:seed": "tsx test/seed-smoke.ts",
    "test:paths": "tsx test/paths-smoke.ts",
    "test:monorepo": "tsx test/monorepo-smoke.ts",
    "test:meta": "tsx test/graph-meta-smoke.ts",
    "test:tools": "tsx test/tools-smoke.ts",
    "test:warm": "tsx test/warm-connection-smoke.ts",
    "test": "npm run test:paths && npm run test:seed && npm run test:monorepo && npm run test:meta && npm run test:tools && npm run test:warm"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "kuzu": "0.11.3",
    "ts-morph": "^27.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
